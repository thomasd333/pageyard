<?xml version="1.0" encoding="UTF-8"?>
<!-- Uploaded files are never executed as scripts (IIS). -->
<configuration>
    <system.webServer>
        <handlers>
            <clear />
            <add name="StaticFile" path="*" verb="*" modules="StaticFileModule" resourceType="File" requireAccess="Read" />
        </handlers>
    </system.webServer>
</configuration>
